#!/usr/bin/env bash
set -euo pipefail

LOGIN_HOST="${FASRC_LOGIN_HOST:-fasrc}"
REMOTE_ALIAS="${FASRC_COMPUTE_ALIAS:-fasrc-compute}"
JOB_NAME="${FASRC_JOB_NAME:-fasrc}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROXY_COMMAND="${FASRC_PROXY_COMMAND:-$SCRIPT_DIR/fasrc-proxy}"
LOCAL_PUBKEY="${FASRC_LOCAL_PUBKEY:-$HOME/.ssh/id_ed25519.pub}"
SSH_INCLUDE="${FASRC_SSH_INCLUDE_FILE:-$HOME/.ssh/fasrc_compute_config}"
STATE_DIR="${FASRC_STATE_DIR:-$HOME/.local/state/fasrc}"
STATE_FILE="$STATE_DIR/current.env"
CONFIG_DIR="${FASRC_CONFIG_DIR:-$HOME/.config/fasrc}"
EXTENSIONS_FILE="${FASRC_VSCODE_EXTENSIONS_FILE:-$CONFIG_DIR/extensions.txt}"
VSCODE_QUALITY="${FASRC_VSCODE_QUALITY:-stable}"
VSCODE_RELEASES_URL="${FASRC_VSCODE_RELEASES_URL:-https://update.code.visualstudio.com/api/releases/$VSCODE_QUALITY}"

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
fasrc opens VS Code on FASRC SLURM compute nodes.

Usage:
  fasrc [options] [remote-path]
  fasrc launch [options] [remote-path]
  fasrc resume [options] [remote-path]
  fasrc new [options] [remote-path]
  fasrc update [--job JOB_ID | --all | --current]
  fasrc setup [--job JOB_ID | --all | --current]
  fasrc extensions [list|add|path|edit]
  fasrc bootstrap
  fasrc status
  fasrc stop [--job JOB_ID | --all]
  fasrc help [topic]

Subcommands:
  launch    Default action. Reuse a running job, or allocate one if none exist.
  resume    Same as launch; kept as a readable alias.
  new       Force a fresh SLURM allocation, then open it in VS Code.
  update    Check VS Code version, update local extensions, and apply setup.
  setup     Apply the configured VS Code server path and remote extensions.
  extensions
            Manage the extension ID list used by setup/update.
  status    List running fasrc jobs and refresh local SSH aliases.
  stop      Cancel the preferred fasrc job, a specific job, or all of them.
  bootstrap Ensure local and cluster SSH public keys are in authorized_keys.
  help      Show this help. Topics: launch, update, extensions, status, stop,
            bootstrap, examples, env.

Job selection:
  - Jobs are discovered by SLURM job name fasrc.
  - Existing jobs are reused by default.
  - The saved preferred job is reused first; otherwise the highest job ID is used.
  - Use --job JOB_ID to open a specific running job.
  - Each running job gets an SSH alias: fasrc-compute-JOB_ID
  - The generic alias fasrc-compute resolves to a reachable running job dynamically.

Launch options:
  --new                 Force a new SLURM allocation
  --job JOB_ID          Reuse a specific existing job
  --time HH:MM:SS       SLURM wall time (default when creating: 08:00:00)
  --cpus N              CPUs per task (default when creating: 4)
  --mem SIZE            Memory request, e.g. 16G (default when creating: 16G)
  --partition NAME      SLURM partition
  --account NAME        SLURM account
  --constraint VALUE    SLURM constraint
  --gres VALUE          SLURM gres request
  --qos NAME            SLURM qos
  --reservation NAME    SLURM reservation
  --no-open             Update SSH config/settings, but do not open VS Code
  --                    Pass any remaining args directly to sbatch

Remote path:
  - No path, "." or "~" opens the remote home directory.
  - Relative paths are resolved under the remote home directory.
  - Absolute paths are opened as-is.

Examples:
  fasrc status
  fasrc --job 12345678
  fasrc --job 12345678 project
  fasrc update --all
  fasrc extensions add ms-python.python ms-toolsai.jupyter
  fasrc new --partition shared --cpus 8 --mem 32G --time 12:00:00 project
  fasrc stop --job 12345678

More detail:
  fasrc help launch
  fasrc help update
  fasrc help examples
EOF
}

help_cmd() {
  local topic="${1:-overview}"

  case "$topic" in
    overview|all|-h|--help)
      usage
      ;;
    launch|resume|new)
      cat <<'EOF'
Launch, resume, and new:
  fasrc [options] [remote-path]
  fasrc launch [options] [remote-path]
  fasrc resume [options] [remote-path]
  fasrc new [options] [remote-path]

Behavior:
  - launch/resume/default reuse an existing running fasrc job when possible.
  - new, --new, or any allocation option forces a fresh SLURM job.
  - If no running fasrc jobs exist, launch allocates a new one.
  - The script opens a new VS Code window unless FASRC_REUSE_WINDOW=1.
  - Before opening VS Code, it refreshes ~/.ssh/fasrc_compute_config and VS Code
    Remote-SSH settings for the target compute alias.
  - By default, the VS Code server path is persistent:
    REMOTE_HOME/.vscode-server-fasrc

Useful options:
  --job JOB_ID          Open one specific running fasrc job.
  --new                 Force a new job.
  --time HH:MM:SS       Wall time for new jobs. Default: 08:00:00.
  --cpus N              CPUs per task for new jobs. Default: 4.
  --mem SIZE            Memory for new jobs. Default: 16G.
  --partition NAME      SLURM partition.
  --account NAME        SLURM account.
  --constraint VALUE    SLURM constraint.
  --gres VALUE          SLURM generic resource request.
  --qos NAME            SLURM QOS.
  --reservation NAME    SLURM reservation.
  --no-open             Refresh SSH config/settings without opening VS Code.
  --                    Pass remaining arguments directly to sbatch.

Examples:
  fasrc
  fasrc --job 12345678
  fasrc --job 12345678 project
  fasrc new --partition shared --cpus 8 --mem 32G --time 12:00:00 project
EOF
      ;;
    update|setup|vscode)
      cat <<'EOF'
Update and setup:
  fasrc update [--job JOB_ID | --all | --current]
  fasrc setup [--job JOB_ID | --all | --current]

What update does:
  - Prints the installed VS Code version and checks the latest stable version.
  - Runs "code --update-extensions" for local VS Code extensions.
  - Refreshes fasrc-compute-JOB_ID SSH aliases for running jobs.
  - Writes VS Code Remote-SSH settings for a persistent server path.
  - Adds configured extensions to Remote-SSH's default extension list, so VS
    Code installs them automatically on SSH hosts.

What setup does:
  - Same remote setup behavior as update.
  - Also runs the local extension update unless --no-local-update is used.

Job selection:
  --all                 Apply to all running fasrc jobs. This is default.
  --job JOB_ID          Apply to one running job.
  --current             Apply only to the saved/current preferred job.
  --local-only          Only check/update local VS Code; do not touch FASRC.
  --no-local-update     Skip "code --update-extensions".
  --no-remote-extensions
                        Write server settings, but do not add default extensions.
  --install-now         Also try to install remote extensions immediately on
                        selected live jobs if the VS Code server is present.

Extension list:
  fasrc uses ~/.config/fasrc/extensions.txt by default.
  Blank lines and lines starting with "#" are ignored.

Examples:
  fasrc update
  fasrc update --job 12345678
  fasrc setup --current --no-local-update
  fasrc extensions add ms-python.python ms-toolsai.jupyter
EOF
      ;;
    extensions|extension|ext)
      cat <<'EOF'
Extensions:
  fasrc extensions
  fasrc extensions list
  fasrc extensions add EXT_ID [EXT_ID ...]
  fasrc extensions path
  fasrc extensions edit
  fasrc extensions seed-local

The extension list controls what "fasrc setup" and "fasrc update" add to
remote.SSH.defaultExtensions. VS Code then installs those extensions
automatically on SSH hosts. Extension IDs look like publisher.name.

Examples:
  fasrc extensions add james-yu.latex-workshop
  fasrc extensions add anthropic.claude-code oscarphysics.claudetex openai.chatgpt
  fasrc extensions list
EOF
      ;;
    status|jobs|query)
      cat <<'EOF'
Status:
  fasrc status

What it does:
  - Opens or reuses the cached SSH control connection to the FASRC login host.
  - Runs squeue on the login host.
  - Lists only RUNNING jobs whose SLURM job name is fasrc.
  - Rewrites ~/.ssh/fasrc_compute_config with one alias per running job.
  - Marks the current preferred job with "*".

Example output:
  Generic alias fasrc-compute resolves dynamically at connection time.
  Current preferred job: fasrc-compute-12345678
  * job 12345678 on holy7c08303 (fasrc-compute-12345678)
    job 12345679 on holy7c06107 (fasrc-compute-12345679)

Open a listed job:
  fasrc --job 12345678

Open three listed jobs in three VS Code windows:
  fasrc --job 12345678
  fasrc --job 12345679
  fasrc --job 12345680
EOF
      ;;
    stop|cancel|scancel)
      cat <<'EOF'
Stop:
  fasrc stop
  fasrc stop --job JOB_ID
  fasrc stop --all

Behavior:
  - stop cancels the current preferred fasrc job.
  - stop --job JOB_ID cancels that specific running fasrc job.
  - stop --all cancels all running fasrc jobs.
  - After cancellation, local SSH aliases are refreshed for any jobs still running.

Examples:
  fasrc stop
  fasrc stop --job 12345678
  fasrc stop --all
EOF
      ;;
    bootstrap|keys|ssh)
      cat <<'EOF'
Bootstrap:
  fasrc bootstrap

What it does:
  - Establishes the cached SSH connection to the FASRC login host.
  - Ensures ~/.ssh/authorized_keys exists on FASRC with safe permissions.
  - Ensures the cluster's own SSH public key is authorized.
  - Adds your local public key, normally ~/.ssh/id_ed25519.pub, to FASRC.
  - Cleans up one old broken authorized_keys line from earlier bootstrap logic.

Launch also runs the bootstrap steps automatically, so you normally do not need
to run this directly unless SSH key setup needs repair.
EOF
      ;;
    examples|example)
      cat <<'EOF'
Examples:
  # List live fasrc jobs and refresh aliases.
  fasrc status

  # Open the preferred live job in VS Code.
  fasrc

  # Open a specific live job in VS Code.
  fasrc --job 12345678

  # Open the same project path on three live jobs.
  fasrc --job 12345678 project
  fasrc --job 12345679 project
  fasrc --job 12345680 project

  # Check VS Code version, update local extensions, and setup live jobs.
  fasrc update

  # Add remote extensions to the setup list.
  fasrc extensions add ms-python.python ms-toolsai.jupyter

  # Allocate a new job with explicit resources.
  fasrc new --partition shared --cpus 8 --mem 32G --time 12:00:00 project

  # Pass raw sbatch flags after --.
  fasrc new -- --mail-type=END --mail-user=you@example.edu

  # Refresh SSH config and VS Code settings without opening a window.
  fasrc --job 12345678 --no-open

  # Cancel one live job, or all live fasrc jobs.
  fasrc stop --job 12345678
  fasrc stop --all
EOF
      ;;
    env|environment|config)
      cat <<'EOF'
Environment variables:
  FASRC_LOGIN_HOST                  SSH host for the login node. Default: fasrc
  FASRC_COMPUTE_ALIAS               Generic compute alias. Default: fasrc-compute
  FASRC_JOB_NAME                    SLURM job name to discover. Default: fasrc
  FASRC_PROXY_COMMAND               Local SSH proxy helper. Default: fasrc-proxy next to fasrc
  FASRC_CONFIG_DIR                  Config directory. Default: ~/.config/fasrc
  FASRC_VSCODE_EXTENSIONS_FILE      Extension list. Default: ~/.config/fasrc/extensions.txt
  FASRC_LOCAL_PUBKEY                Local public key for bootstrap. Default: ~/.ssh/id_ed25519.pub
  FASRC_SSH_INCLUDE_FILE            Generated SSH include file. Default: ~/.ssh/fasrc_compute_config
  FASRC_STATE_DIR                   State directory. Default: ~/.local/state/fasrc
  FASRC_VSCODE_SERVER_INSTALL_ROOT  Remote VS Code server path. Default: REMOTE_HOME/.vscode-server-fasrc
  FASRC_VSCODE_USER_SETTINGS        VS Code settings file to update. Default: ~/Library/Application Support/Code/User/settings.json
  FASRC_REUSE_WINDOW=1              Reuse a VS Code window instead of opening a new one.
  FASRC_VSCODE_QUALITY              VS Code release channel. Default: stable

Timeouts:
  FASRC_SSH_PROBE_TIMEOUT
  FASRC_SSH_READY_TIMEOUT
  FASRC_SSH_READY_INTERVAL
  FASRC_LOGIN_TIMEOUT
  FASRC_LOGIN_CONNECT_TIMEOUT
  FASRC_POLL_SECONDS                Remote allocator poll interval while waiting on SLURM.

Files managed:
  ~/.ssh/fasrc_compute_config       Local SSH aliases for live jobs.
  ~/.config/fasrc/extensions.txt    Remote extension setup list.
  ~/.local/state/fasrc/current.env
                                    Saved preferred job.
  VS Code settings.json             Remote-SSH platform and server install path.
  ~/.local/bin/fasrc-alloc          Remote helper installed on the FASRC login host.
EOF
      ;;
    *)
      die "Unknown help topic: $topic. Try 'fasrc help'."
      ;;
  esac
}

detect_remote_user() {
  local user
  user="$(ssh -G "$LOGIN_HOST" 2>/dev/null | awk '/^user / {print $2; exit}')"
  if [[ -n "$user" ]]; then
    printf '%s\n' "$user"
    return
  fi
  printf '%s\n' "$USER"
}

REMOTE_USER="$(detect_remote_user)"
VSCODE_SERVER_INSTALL_ROOT_OVERRIDE="${FASRC_VSCODE_SERVER_INSTALL_ROOT:-}"
CODE_USER_SETTINGS="${FASRC_VSCODE_USER_SETTINGS:-$HOME/Library/Application Support/Code/User/settings.json}"
SSH_PROBE_TIMEOUT="${FASRC_SSH_PROBE_TIMEOUT:-18}"
SSH_READY_TIMEOUT="${FASRC_SSH_READY_TIMEOUT:-90}"
SSH_READY_INTERVAL="${FASRC_SSH_READY_INTERVAL:-3}"
SSH_LOGIN_TIMEOUT="${FASRC_LOGIN_TIMEOUT:-120}"
SSH_LOGIN_CONNECT_TIMEOUT="${FASRC_LOGIN_CONNECT_TIMEOUT:-20}"

job_alias() {
  printf '%s-%s\n' "$REMOTE_ALIAS" "$1"
}

append_dynamic_default_block() {
  cat >>"$SSH_INCLUDE" <<EOF

Host $REMOTE_ALIAS
  HostName $REMOTE_ALIAS
  User $REMOTE_USER
  ProxyCommand $PROXY_COMMAND
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  CheckHostIP no
EOF
}

write_placeholder_include() {
  mkdir -p "$HOME/.ssh"
  cat >"$SSH_INCLUDE" <<'EOF'
# Auto-generated by `fasrc`.
# Active compute-node aliases are written here.
EOF
  append_dynamic_default_block
}

append_host_block() {
  local alias="$1"
  local node="$2"

  cat >>"$SSH_INCLUDE" <<EOF

Host $alias
  HostName $node
  User $REMOTE_USER
  ProxyJump $LOGIN_HOST
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  StrictHostKeyChecking accept-new
EOF
}

find_job_entry() {
  local jobs="$1"
  local target_job="$2"
  local job_id node

  while IFS='|' read -r job_id node; do
    [[ -n "$job_id" ]] || continue
    if [[ "$job_id" == "$target_job" ]]; then
      printf '%s|%s\n' "$job_id" "$node"
      return 0
    fi
  done <<<"$jobs"

  return 1
}

choose_default_entry() {
  local jobs="$1"
  local saved_job=""
  local best_job=""
  local best_node=""
  local job_id node

  if [[ -f "$STATE_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$STATE_FILE"
    saved_job="${CURRENT_JOB:-}"
  fi

  if [[ -n "$saved_job" ]]; then
    if find_job_entry "$jobs" "$saved_job" >/dev/null; then
      find_job_entry "$jobs" "$saved_job"
      return 0
    fi
  fi

  while IFS='|' read -r job_id node; do
    [[ -n "$job_id" ]] || continue
    if [[ -z "$best_job" || "$job_id" -gt "$best_job" ]]; then
      best_job="$job_id"
      best_node="$node"
    fi
  done <<<"$jobs"

  [[ -n "$best_job" ]] || return 1
  printf '%s|%s\n' "$best_job" "$best_node"
}

run_with_timeout() {
  local seconds="$1"
  shift

  perl -e '
    use strict;
    use warnings;

    my $timeout = shift @ARGV;
    my $pid = fork();
    die "fork failed\n" unless defined $pid;

    if ($pid == 0) {
      exec @ARGV;
      exit 127;
    }

    local $SIG{ALRM} = sub {
      kill "TERM", $pid;
      select undef, undef, undef, 0.5;
      kill "KILL", $pid;
      exit 124;
    };

    alarm $timeout;
    waitpid($pid, 0);
    exit($? == -1 ? 1 : ($? & 127 ? 128 + ($? & 127) : (($? >> 8) & 255)));
  ' "$seconds" "$@"
}

probe_compute_alias() {
  local alias="$1"

  run_with_timeout "$SSH_PROBE_TIMEOUT" \
    ssh \
      -o BatchMode=yes \
      -o NumberOfPasswordPrompts=0 \
      -o ConnectionAttempts=1 \
      -o ConnectTimeout=8 \
      -o ServerAliveInterval=3 \
      -o ServerAliveCountMax=1 \
      "$alias" 'printf ready' >/dev/null 2>&1
}

wait_for_compute_alias() {
  local alias="$1"
  local timeout="${2:-$SSH_READY_TIMEOUT}"
  local deadline=$((SECONDS + timeout))

  while ((SECONDS <= deadline)); do
    if probe_compute_alias "$alias"; then
      return 0
    fi
    sleep "$SSH_READY_INTERVAL"
  done

  return 1
}

write_compute_include() {
  local jobs="$1"
  local current_job="$2"
  local current_entry current_node
  local job_id node alias

  current_entry="$(find_job_entry "$jobs" "$current_job")" || die "Current job $current_job is not present in the active job list."
  current_node="${current_entry#*|}"

  write_placeholder_include

  while IFS='|' read -r job_id node; do
    [[ -n "$job_id" ]] || continue
    alias="$(job_alias "$job_id")"
    cat >>"$SSH_INCLUDE" <<EOF

# SLURM job $job_id
EOF
    append_host_block "$alias" "$node"
  done <<<"$jobs"
}

save_current_job() {
  local job_id="$1"
  mkdir -p "$STATE_DIR"
  printf 'CURRENT_JOB=%q\n' "$job_id" >"$STATE_FILE"
}

clear_current_job() {
  rm -f "$STATE_FILE"
}

ensure_code_cli() {
  command -v code >/dev/null 2>&1 || die "The VS Code 'code' CLI is not on PATH. Open a new terminal or source ~/.zshrc."
}

prepare_code_cli_limits() {
  ulimit -n 8192 >/dev/null 2>&1 || true
}

ensure_vscode_remote_settings() {
  local alias="$1"
  local install_root="$2"
  local manage_extensions="${3:-1}"
  local settings_file="$CODE_USER_SETTINGS"
  local tmp_file extensions_json

  command -v jq >/dev/null 2>&1 || {
    printf 'Warning: jq is not available, so VS Code settings were not updated for %s.\n' "$alias" >&2
    return
  }

  ensure_extensions_file
  if [[ "$manage_extensions" == "1" ]]; then
    extensions_json="$(extension_ids | jq -R . | jq -s .)"
  else
    extensions_json="[]"
  fi

  mkdir -p "$(dirname "$settings_file")"
  tmp_file="$(mktemp)"

  if [[ -f "$settings_file" && -s "$settings_file" ]]; then
    jq \
      --arg alias "$alias" \
      --arg install_root "$install_root" \
      --argjson extensions "$extensions_json" \
      '
        .["remote.SSH.serverInstallPath"] = (.["remote.SSH.serverInstallPath"] // {}) |
        .["remote.SSH.serverInstallPath"]["fasrc-compute"] = $install_root |
        .["remote.SSH.serverInstallPath"][$alias] = $install_root |
        .["remote.SSH.remotePlatform"] = (.["remote.SSH.remotePlatform"] // {}) |
        .["remote.SSH.remotePlatform"]["fasrc-compute"] = "linux" |
        .["remote.SSH.remotePlatform"][$alias] = "linux" |
        .["remote.SSH.connectTimeout"] = 120 |
        if ($extensions | length) > 0 then
          .["remote.SSH.defaultExtensions"] = (((.["remote.SSH.defaultExtensions"] // []) + $extensions) | unique)
        else
          .
        end |
        .["latex-workshop.latex.recipe.default"] = "latexmk-fasrc" |
        .["latex-workshop.latex.recipes"] = [
          {
            "name": "latexmk-fasrc",
            "tools": ["latexmk-fasrc"]
          }
        ] |
        .["latex-workshop.latex.tools"] = [
          {
            "name": "latexmk-fasrc",
            "command": "latexmk",
            "args": [
              "-pdf",
              "-synctex=1",
              "-interaction=nonstopmode",
              "-file-line-error",
              "-outdir=build",
              "%DOCFILE_EXT%"
            ],
            "cwd": "%DIR%",
            "env": {}
          }
        ] |
        .["latex-workshop.latex.outDir"] = "%DIR%/build" |
        .["latex-workshop.latex.autoBuild.run"] = "onSave" |
        .["latex-workshop.latex.build.enableMagicComments"] = false |
        .["latex-workshop.latex.clean.method"] = "glob" |
        .["latex-workshop.view.pdf.viewer"] = "tab" |
        .["latex-workshop.view.pdf.tab.editorGroup"] = "right" |
        .["latex-workshop.synctex.afterBuild.enabled"] = true |
        .["latex-workshop.view.pdf.internal.synctex.keybinding"] = "double-click" |
        .["workbench.editorAssociations"] = (.["workbench.editorAssociations"] // {}) |
        .["workbench.editorAssociations"]["*.pdf"] = "latex-workshop-pdf-hook"
      ' "$settings_file" >"$tmp_file" || {
        rm -f "$tmp_file"
        die "Failed to update VS Code settings at $settings_file"
      }
  else
    jq -n \
      --arg alias "$alias" \
      --arg install_root "$install_root" \
      --argjson extensions "$extensions_json" \
      '
        {
          "remote.SSH.serverInstallPath": {
            "fasrc-compute": $install_root,
            ($alias): $install_root
          },
          "remote.SSH.remotePlatform": {
            "fasrc-compute": "linux",
            ($alias): "linux"
          },
          "remote.SSH.connectTimeout": 120
        } |
        if ($extensions | length) > 0 then
          .["remote.SSH.defaultExtensions"] = $extensions
        else
          .
        end |
        .["latex-workshop.latex.recipe.default"] = "latexmk-fasrc" |
        .["latex-workshop.latex.recipes"] = [
          {
            "name": "latexmk-fasrc",
            "tools": ["latexmk-fasrc"]
          }
        ] |
        .["latex-workshop.latex.tools"] = [
          {
            "name": "latexmk-fasrc",
            "command": "latexmk",
            "args": [
              "-pdf",
              "-synctex=1",
              "-interaction=nonstopmode",
              "-file-line-error",
              "-outdir=build",
              "%DOCFILE_EXT%"
            ],
            "cwd": "%DIR%",
            "env": {}
          }
        ] |
        .["latex-workshop.latex.outDir"] = "%DIR%/build" |
        .["latex-workshop.latex.autoBuild.run"] = "onSave" |
        .["latex-workshop.latex.build.enableMagicComments"] = false |
        .["latex-workshop.latex.clean.method"] = "glob" |
        .["latex-workshop.view.pdf.viewer"] = "tab" |
        .["latex-workshop.view.pdf.tab.editorGroup"] = "right" |
        .["latex-workshop.synctex.afterBuild.enabled"] = true |
        .["latex-workshop.view.pdf.internal.synctex.keybinding"] = "double-click" |
        .["workbench.editorAssociations"] = (.["workbench.editorAssociations"] // {}) |
        .["workbench.editorAssociations"]["*.pdf"] = "latex-workshop-pdf-hook"
      ' >"$tmp_file"
  fi

  mv "$tmp_file" "$settings_file"
}

ensure_vscode_base_settings() {
  local manage_extensions="${1:-1}"
  local settings_file="$CODE_USER_SETTINGS"
  local tmp_file extensions_json

  command -v jq >/dev/null 2>&1 || {
    printf 'Warning: jq is not available, so VS Code workflow settings were not updated.\n' >&2
    return
  }

  ensure_extensions_file
  if [[ "$manage_extensions" == "1" ]]; then
    extensions_json="$(extension_ids | jq -R . | jq -s .)"
  else
    extensions_json="[]"
  fi

  mkdir -p "$(dirname "$settings_file")"
  tmp_file="$(mktemp)"

  if [[ -f "$settings_file" && -s "$settings_file" ]]; then
    jq \
      --argjson extensions "$extensions_json" \
      '
        if ($extensions | length) > 0 then
          .["remote.SSH.defaultExtensions"] = (((.["remote.SSH.defaultExtensions"] // []) + $extensions) | unique)
        else
          .
        end |
        .["remote.SSH.serverInstallPath"] = ((.["remote.SSH.serverInstallPath"] // {}) | with_entries(select(.key | test("^fasrc-compute(-.*)?$") | not))) |
        .["remote.SSH.remotePlatform"] = (((.["remote.SSH.remotePlatform"] // {}) | with_entries(select(.key | test("^fasrc-compute(-.*)?$") | not))) + {"fasrc-compute": "linux"}) |
        .["remote.SSH.connectTimeout"] = 120 |
        .["latex-workshop.latex.recipe.default"] = "latexmk-fasrc" |
        .["latex-workshop.latex.recipes"] = [
          {
            "name": "latexmk-fasrc",
            "tools": ["latexmk-fasrc"]
          }
        ] |
        .["latex-workshop.latex.tools"] = [
          {
            "name": "latexmk-fasrc",
            "command": "latexmk",
            "args": [
              "-pdf",
              "-synctex=1",
              "-interaction=nonstopmode",
              "-file-line-error",
              "-outdir=build",
              "%DOCFILE_EXT%"
            ],
            "cwd": "%DIR%",
            "env": {}
          }
        ] |
        .["latex-workshop.latex.outDir"] = "%DIR%/build" |
        .["latex-workshop.latex.autoBuild.run"] = "onSave" |
        .["latex-workshop.latex.build.enableMagicComments"] = false |
        .["latex-workshop.latex.clean.method"] = "glob" |
        .["latex-workshop.view.pdf.viewer"] = "tab" |
        .["latex-workshop.view.pdf.tab.editorGroup"] = "right" |
        .["latex-workshop.synctex.afterBuild.enabled"] = true |
        .["latex-workshop.view.pdf.internal.synctex.keybinding"] = "double-click" |
        .["workbench.editorAssociations"] = (.["workbench.editorAssociations"] // {}) |
        .["workbench.editorAssociations"]["*.pdf"] = "latex-workshop-pdf-hook"
      ' "$settings_file" >"$tmp_file" || {
        rm -f "$tmp_file"
        die "Failed to update VS Code settings at $settings_file"
      }
  else
    jq -n \
      --argjson extensions "$extensions_json" \
      '
        {} |
        if ($extensions | length) > 0 then
          .["remote.SSH.defaultExtensions"] = $extensions
        else
          .
        end |
        .["remote.SSH.serverInstallPath"] = {} |
        .["remote.SSH.remotePlatform"] = {"fasrc-compute": "linux"} |
        .["remote.SSH.connectTimeout"] = 120 |
        .["latex-workshop.latex.recipe.default"] = "latexmk-fasrc" |
        .["latex-workshop.latex.recipes"] = [
          {
            "name": "latexmk-fasrc",
            "tools": ["latexmk-fasrc"]
          }
        ] |
        .["latex-workshop.latex.tools"] = [
          {
            "name": "latexmk-fasrc",
            "command": "latexmk",
            "args": [
              "-pdf",
              "-synctex=1",
              "-interaction=nonstopmode",
              "-file-line-error",
              "-outdir=build",
              "%DOCFILE_EXT%"
            ],
            "cwd": "%DIR%",
            "env": {}
          }
        ] |
        .["latex-workshop.latex.outDir"] = "%DIR%/build" |
        .["latex-workshop.latex.autoBuild.run"] = "onSave" |
        .["latex-workshop.latex.build.enableMagicComments"] = false |
        .["latex-workshop.latex.clean.method"] = "glob" |
        .["latex-workshop.view.pdf.viewer"] = "tab" |
        .["latex-workshop.view.pdf.tab.editorGroup"] = "right" |
        .["latex-workshop.synctex.afterBuild.enabled"] = true |
        .["latex-workshop.view.pdf.internal.synctex.keybinding"] = "double-click" |
        .["workbench.editorAssociations"] = (.["workbench.editorAssociations"] // {}) |
        .["workbench.editorAssociations"]["*.pdf"] = "latex-workshop-pdf-hook"
      ' >"$tmp_file"
  fi

  mv "$tmp_file" "$settings_file"
}

ensure_login_connection() {
  mkdir -p "$HOME/.ssh/sockets"
  chmod 700 "$HOME/.ssh/sockets"

  if ssh -O check "$LOGIN_HOST" >/dev/null 2>&1; then
    return
  fi

  printf 'Authenticating to %s as %s...\n' "$LOGIN_HOST" "$REMOTE_USER" >&2
  run_with_timeout "$SSH_LOGIN_TIMEOUT" \
    ssh \
      -o ConnectTimeout="$SSH_LOGIN_CONNECT_TIMEOUT" \
      -o ServerAliveInterval=5 \
      -o ServerAliveCountMax=1 \
      -MNf "$LOGIN_HOST" || die "Could not establish a cached SSH login to $LOGIN_HOST. Check VPN/network access, then run 'fasrc' again."
}

reset_login_connection() {
  local control_path

  printf 'Refreshing %s SSH control connection after a compute-node probe failed.\n' "$LOGIN_HOST" >&2
  run_with_timeout 8 ssh -O exit "$LOGIN_HOST" >/dev/null 2>&1 || true

  control_path="$(ssh -G "$LOGIN_HOST" 2>/dev/null | awk '/^controlpath / {print $2; exit}')"
  if [[ -n "$control_path" && -S "$control_path" ]]; then
    rm -f "$control_path"
  fi

  ensure_login_connection
}

bootstrap_remote_keys() {
  [[ -f "$LOCAL_PUBKEY" ]] || die "Local public key not found: $LOCAL_PUBKEY"

  ssh "$LOGIN_HOST" "bash -s" <<'REMOTE'
set -euo pipefail

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"
touch "$HOME/.ssh/authorized_keys"
chmod 600 "$HOME/.ssh/authorized_keys"

cluster_key=''
if [[ -f "$HOME/.ssh/id_ed25519.pub" ]]; then
  cluster_key="$(<"$HOME/.ssh/id_ed25519.pub")"
elif [[ -f "$HOME/.ssh/id_ed25519" ]]; then
  cluster_key="$(ssh-keygen -y -f "$HOME/.ssh/id_ed25519")"
elif [[ -f "$HOME/.ssh/id_rsa.pub" ]]; then
  cluster_key="$(<"$HOME/.ssh/id_rsa.pub")"
elif [[ -f "$HOME/.ssh/id_rsa" ]]; then
  cluster_key="$(ssh-keygen -y -f "$HOME/.ssh/id_rsa")"
else
  ssh-keygen -t ed25519 -N '' -f "$HOME/.ssh/id_ed25519" >/dev/null
  cluster_key="$(<"$HOME/.ssh/id_ed25519.pub")"
fi

if ! grep -qxF "$cluster_key" "$HOME/.ssh/authorized_keys"; then
  printf '%s\n' "$cluster_key" >>"$HOME/.ssh/authorized_keys"
fi
REMOTE

  local local_key_b64
  local_key_b64="$(base64 <"$LOCAL_PUBKEY" | tr -d '\n')"

  ssh "$LOGIN_HOST" "bash -s" -- "$local_key_b64" <<'REMOTE'
set -euo pipefail

local_key="$(printf '%s' "$1" | base64 -d | tr -d '\r\n')"

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"
touch "$HOME/.ssh/authorized_keys"
chmod 600 "$HOME/.ssh/authorized_keys"

if ! grep -qxF "$local_key" "$HOME/.ssh/authorized_keys"; then
  printf '%s\n' "$local_key" >>"$HOME/.ssh/authorized_keys"
fi

# Clean up the truncated line created by older broken bootstrap logic.
tmp_file="$(mktemp)"
grep -vxF 'ssh-ed25519' "$HOME/.ssh/authorized_keys" >"$tmp_file"
mv "$tmp_file" "$HOME/.ssh/authorized_keys"
chmod 600 "$HOME/.ssh/authorized_keys"
REMOTE
}

install_remote_allocator() {
  ssh "$LOGIN_HOST" 'mkdir -p "$HOME/.local/bin" "$HOME/.ssh" && chmod 700 "$HOME/.ssh"'
  ssh "$LOGIN_HOST" "cat > ~/.local/bin/fasrc-alloc && chmod 755 ~/.local/bin/fasrc-alloc" <<'REMOTE'
#!/usr/bin/env bash
set -euo pipefail

poll_seconds="${FASRC_POLL_SECONDS:-5}"
job_name="${FASRC_JOB_NAME:-fasrc}"

job_id="$(sbatch --parsable --job-name="$job_name" "$@" --wrap='sleep infinity')"

while true; do
  status="$(squeue -j "$job_id" -h -o '%T|%N' || true)"
  if [[ -z "$status" ]]; then
    printf 'SLURM job %s disappeared before starting.\n' "$job_id" >&2
    exit 1
  fi

  state="${status%%|*}"
  node="${status#*|}"

  case "$state" in
    RUNNING)
      if [[ -n "$node" && "$node" != "(null)" && "$node" != "n/a" ]]; then
        printf '%s|%s\n' "$job_id" "$node"
        exit 0
      fi
      ;;
    PENDING|CONFIGURING|COMPLETING)
      ;;
    *)
      printf 'SLURM job %s entered state %s.\n' "$job_id" "$state" >&2
      exit 1
      ;;
  esac

  sleep "$poll_seconds"
done
REMOTE
}

remote_home() {
  ssh "$LOGIN_HOST" 'printf "%s" "$HOME"'
}

vscode_server_install_root() {
  local remote_home_path="$1"

  if [[ -n "$VSCODE_SERVER_INSTALL_ROOT_OVERRIDE" ]]; then
    case "$VSCODE_SERVER_INSTALL_ROOT_OVERRIDE" in
      "~")
        printf '%s\n' "$remote_home_path"
        ;;
      "~/"*)
        printf '%s/%s\n' "${remote_home_path%/}" "${VSCODE_SERVER_INSTALL_ROOT_OVERRIDE#"~/"}"
        ;;
      *)
        printf '%s\n' "$VSCODE_SERVER_INSTALL_ROOT_OVERRIDE"
        ;;
    esac
    return
  fi

  printf '%s/.vscode-server-fasrc\n' "${remote_home_path%/}"
}

list_remote_jobs() {
  ssh "$LOGIN_HOST" "bash -s" -- "$REMOTE_USER" "$JOB_NAME" <<'REMOTE'
set -euo pipefail

remote_user="$1"
job_name="$2"

squeue -u "$remote_user" -h -o '%A|%T|%N|%j' | awk -F'|' -v job_name="$job_name" '
  $4 == job_name && $2 == "RUNNING" && $3 != "(null)" && $3 != "n/a" {
    print $1 "|" $3
  }
'
REMOTE
}

allocate_new_job() {
  local output job_id node
  output="$(ssh "$LOGIN_HOST" "~/.local/bin/fasrc-alloc" "$@")"
  [[ -n "$output" ]] || die "Allocator returned no output."

  job_id="${output%%|*}"
  node="${output#*|}"

  [[ "$node" != *','* ]] || die "Allocator returned multiple nodes: $node"
  [[ "$node" != *'['* ]] || die "Allocator returned a compressed nodelist: $node"

  printf '%s|%s\n' "$job_id" "$node"
}

append_job_entry() {
  local jobs="$1"
  local entry="$2"

  if [[ -z "$jobs" ]]; then
    printf '%s\n' "$entry"
    return
  fi

  printf '%s\n%s\n' "$jobs" "$entry"
}

build_remote_uri() {
  local alias="$1"
  local remote_home_path="$2"
  local open_path="${3:-}"
  local resolved="$remote_home_path"

  if [[ -n "$open_path" && "$open_path" != "." && "$open_path" != "~" ]]; then
    if [[ "$open_path" = /* ]]; then
      resolved="$open_path"
    else
      resolved="${remote_home_path%/}/$open_path"
    fi
  fi

  printf 'vscode-remote://ssh-remote+%s%s\n' "$alias" "$resolved"
}

ensure_extensions_file() {
  if [[ -f "$EXTENSIONS_FILE" ]]; then
    return
  fi

  mkdir -p "$(dirname "$EXTENSIONS_FILE")"
  cat >"$EXTENSIONS_FILE" <<'EOF'
# Remote VS Code extensions for `fasrc setup` and `fasrc update`.
# Add one extension ID per line.
james-yu.latex-workshop
anthropic.claude-code
oscarphysics.claudetex
openai.chatgpt
EOF
}

extension_ids() {
  ensure_extensions_file
  awk '
    {
      sub(/\r$/, "")
      sub(/[[:space:]]*#.*/, "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      if ($0 != "") {
        print
      }
    }
  ' "$EXTENSIONS_FILE"
}

extensions_cmd() {
  local action="${1:-list}"
  local ext existing configured

  case "$action" in
    list)
      ensure_extensions_file
      printf 'Extension file: %s\n' "$EXTENSIONS_FILE"
      configured="$(extension_ids)"
      if [[ -z "$configured" ]]; then
        printf '  (none configured)\n'
      else
        printf '%s\n' "$configured" | sed 's/^/  /'
      fi
      ;;
    path)
      ensure_extensions_file
      printf '%s\n' "$EXTENSIONS_FILE"
      ;;
    edit)
      ensure_extensions_file
      if command -v code >/dev/null 2>&1; then
        code "$EXTENSIONS_FILE"
      elif [[ -n "${EDITOR:-}" ]]; then
        "$EDITOR" "$EXTENSIONS_FILE"
      else
        printf 'Edit this file: %s\n' "$EXTENSIONS_FILE"
      fi
      ;;
    add)
      shift || true
      [[ $# -gt 0 ]] || die "Usage: fasrc extensions add EXT_ID [EXT_ID ...]"
      ensure_extensions_file
      for ext in "$@"; do
        existing="$(extension_ids | grep -ixF "$ext" || true)"
        if [[ -n "$existing" ]]; then
          printf 'Already present: %s\n' "$ext"
        else
          printf '%s\n' "$ext" >>"$EXTENSIONS_FILE"
          printf 'Added: %s\n' "$ext"
        fi
      done
      ;;
    seed-local)
      ensure_code_cli
      ensure_extensions_file
      while IFS= read -r ext; do
        [[ -n "$ext" ]] || continue
        existing="$(extension_ids | grep -ixF "$ext" || true)"
        if [[ -z "$existing" ]]; then
          printf '%s\n' "$ext" >>"$EXTENSIONS_FILE"
          printf 'Added: %s\n' "$ext"
        fi
      done < <(code --list-extensions 2>/dev/null)
      ;;
    -h|--help|help)
      help_cmd extensions
      ;;
    *)
      die "Unknown extensions action: $action. Try 'fasrc help extensions'."
      ;;
  esac
}

local_vscode_version() {
  code --version 2>/dev/null | sed -n '1p'
}

local_vscode_commit() {
  code --version 2>/dev/null | sed -n '2p'
}

latest_vscode_version() {
  command -v curl >/dev/null 2>&1 || return 1
  curl -fsSL "$VSCODE_RELEASES_URL" 2>/dev/null | sed -E 's/^\["([^"]+)".*/\1/'
}

check_vscode_update() {
  local current_version current_commit latest_version

  ensure_code_cli
  current_version="$(local_vscode_version)"
  current_commit="$(local_vscode_commit)"

  printf 'Local VS Code: %s\n' "${current_version:-unknown}"
  if [[ -n "$current_commit" ]]; then
    printf 'Local VS Code commit: %s\n' "$current_commit"
  fi

  latest_version="$(latest_vscode_version || true)"
  if [[ -z "$latest_version" || "$latest_version" == "["* ]]; then
    printf 'Latest VS Code check: unavailable\n'
    return
  fi

  if [[ "$current_version" == "$latest_version" ]]; then
    printf 'Latest VS Code stable: %s (installed)\n' "$latest_version"
  else
    printf 'Latest VS Code stable: %s (update available; use VS Code > Check for Updates)\n' "$latest_version"
  fi
}

update_local_extensions() {
  ensure_code_cli
  printf 'Updating local VS Code extensions...\n'
  code --update-extensions || printf 'Warning: local VS Code extension update failed.\n' >&2
}

install_remote_extensions() {
  local alias="$1"
  local install_root="$2"
  local commit="$3"
  shift 3

  if [[ $# -eq 0 ]]; then
    printf 'No remote extensions configured in %s.\n' "$EXTENSIONS_FILE"
    return 0
  fi

  printf 'Setting up remote VS Code extensions on %s...\n' "$alias"
  ssh "$alias" "bash -s" -- "$install_root" "$commit" "$@" <<'REMOTE'
set -euo pipefail

install_root="$1"
commit="$2"
shift 2

mkdir -p "$install_root"

server=""
for candidate in \
  "$install_root/bin/$commit/bin/code-server" \
  "$install_root/.vscode-server/bin/$commit/bin/code-server" \
  "$install_root/cli/servers/Stable-$commit/server/bin/code-server" \
  "$HOME/.vscode-server/bin/$commit/bin/code-server" \
  "$HOME/.vscode-server/cli/servers/Stable-$commit/server/bin/code-server"
do
  if [[ -x "$candidate" ]]; then
    server="$candidate"
    break
  fi
done

if [[ -z "$server" ]]; then
  printf 'No VS Code server for commit %s is installed yet under %s.\n' "$commit" "$install_root" >&2
  printf 'Open this job once with fasrc --job JOB_ID, wait for VS Code to finish connecting, then run fasrc update --job JOB_ID.\n' >&2
  exit 20
fi

printf 'Remote VS Code server: %s\n' "$server"
failures=0
for ext in "$@"; do
  printf 'Installing/updating %s...\n' "$ext"
  if "$server" --install-extension "$ext" --force >/dev/null; then
    printf 'Installed/updated %s\n' "$ext"
  else
    printf 'Failed to install/update %s\n' "$ext" >&2
    failures=$((failures + 1))
  fi
done

exit "$failures"
REMOTE
}

setup_vscode_cmd() {
  local requested_job=""
  local apply_all=1
  local apply_current=0
  local local_only=0
  local update_local=1
  local manage_remote_extensions=1
  local install_now=0
  local jobs="" selected_jobs="" target_entry="" current_job="" home_path="" install_root="" commit=""
  local job_id node alias
  local -a extensions=()
  local failures=0

  while (($#)); do
    case "$1" in
      --job)
        [[ $# -ge 2 ]] || die "Missing value for --job"
        requested_job="$2"
        apply_all=0
        apply_current=0
        shift 2
        ;;
      --all)
        apply_all=1
        apply_current=0
        requested_job=""
        shift
        ;;
      --current)
        apply_all=0
        apply_current=1
        requested_job=""
        shift
        ;;
      --local-only)
        local_only=1
        shift
        ;;
      --no-local-update)
        update_local=0
        shift
        ;;
      --no-remote-extensions)
        manage_remote_extensions=0
        shift
        ;;
      --install-now)
        install_now=1
        shift
        ;;
      -h|--help|help)
        help_cmd update
        return
        ;;
      *)
        die "Unknown option for update/setup: $1"
        ;;
    esac
  done

  ensure_code_cli
  check_vscode_update
  if ((update_local)); then
    update_local_extensions
  fi

  ensure_extensions_file
  while IFS= read -r ext; do
    extensions+=("$ext")
  done < <(extension_ids)

  printf 'Remote extension list: %s\n' "$EXTENSIONS_FILE"
  if [[ "${#extensions[@]}" -eq 0 ]]; then
    printf 'No remote extensions configured. Add them with: fasrc extensions add EXT_ID\n'
  else
    printf 'Configured remote extensions: %s\n' "${extensions[*]}"
  fi

  ensure_vscode_base_settings "$manage_remote_extensions"
  printf 'Updated base VS Code workflow settings.\n'

  if ((local_only)); then
    return
  fi

  ensure_login_connection
  jobs="$(list_remote_jobs)"
  if [[ -z "$jobs" ]]; then
    clear_current_job
    write_placeholder_include
    printf 'No active %s jobs. Local VS Code update/setup is complete.\n' "$JOB_NAME"
    return
  fi

  target_entry="$(choose_default_entry "$jobs")"
  current_job="${target_entry%%|*}"
  write_compute_include "$jobs" "$current_job"

  if [[ -n "$requested_job" ]]; then
    selected_jobs="$(find_job_entry "$jobs" "$requested_job")" || die "Active fasrc job $requested_job was not found."
  elif ((apply_current)); then
    selected_jobs="$target_entry"
  elif ((apply_all)); then
    selected_jobs="$jobs"
  fi

  home_path="$(remote_home)"
  install_root="$(vscode_server_install_root "$home_path")"
  commit="$(local_vscode_commit)"
  [[ -n "$commit" ]] || die "Could not determine local VS Code commit."

  printf 'Remote VS Code server root: %s\n' "$install_root"

  while IFS='|' read -r job_id node; do
    [[ -n "$job_id" ]] || continue
    alias="$(job_alias "$job_id")"

    ensure_vscode_remote_settings "$alias" "$install_root" "$manage_remote_extensions"

    if ! probe_compute_alias "$alias"; then
      reset_login_connection
      if ! probe_compute_alias "$alias"; then
        printf 'Skipping %s: SSH to %s is not responding.\n' "$job_id" "$alias" >&2
        failures=$((failures + 1))
        continue
      fi
    fi

    if ((install_now)) && ((manage_remote_extensions)) && [[ "${#extensions[@]}" -gt 0 ]]; then
      if ! install_remote_extensions "$alias" "$install_root" "$commit" "${extensions[@]}"; then
        printf 'Remote extension setup had errors on %s.\n' "$alias" >&2
        failures=$((failures + 1))
      fi
    else
      printf 'Updated VS Code settings for %s.\n' "$alias"
    fi
  done <<<"$selected_jobs"

  if [[ "$failures" -gt 0 ]]; then
    return 1
  fi
}

refresh_local_config() {
  local jobs="$1"
  local target_entry="$2"
  local target_job

  if [[ -z "$jobs" ]]; then
    clear_current_job
    write_placeholder_include
    return
  fi

  target_job="${target_entry%%|*}"
  write_compute_include "$jobs" "$target_job"
  save_current_job "$target_job"
}

launch_cmd() {
  local open_path=""
  local no_open=0
  local force_new=0
  local allocated_new=0
  local requested_job=""
  local time_set=0
  local cpus_set=0
  local mem_set=0
  local -a alloc_args=()
  local jobs="" target_entry="" target_job="" target_alias="" home_path="" install_root="" uri=""

  while (($#)); do
    case "$1" in
      --new)
        force_new=1
        shift
        ;;
      --job)
        [[ $# -ge 2 ]] || die "Missing value for --job"
        requested_job="$2"
        shift 2
        ;;
      --time)
        [[ $# -ge 2 ]] || die "Missing value for --time"
        alloc_args+=("$1" "$2")
        time_set=1
        force_new=1
        shift 2
        ;;
      --cpus)
        [[ $# -ge 2 ]] || die "Missing value for --cpus"
        alloc_args+=(--cpus-per-task "$2")
        cpus_set=1
        force_new=1
        shift 2
        ;;
      --mem|--partition|--account|--constraint|--gres|--qos|--reservation)
        [[ $# -ge 2 ]] || die "Missing value for $1"
        alloc_args+=("$1" "$2")
        if [[ "$1" == "--mem" ]]; then
          mem_set=1
        fi
        force_new=1
        shift 2
        ;;
      --no-open)
        no_open=1
        shift
        ;;
      --)
        shift
        while (($#)); do
          alloc_args+=("$1")
          shift
        done
        force_new=1
        ;;
      -*)
        die "Unknown option: $1. Use -- for raw sbatch args."
        ;;
      *)
        [[ -z "$open_path" ]] || die "Only one remote path can be supplied."
        open_path="$1"
        shift
        ;;
    esac
  done

  [[ -z "$requested_job" || "$force_new" -eq 0 ]] || die "Use either --job or --new/allocation options, not both."

  ensure_code_cli
  ensure_login_connection
  bootstrap_remote_keys
  install_remote_allocator

  jobs="$(list_remote_jobs)"

  if [[ -n "$jobs" ]]; then
    target_entry="$(choose_default_entry "$jobs")" || target_entry=""
    if [[ -n "$target_entry" ]]; then
      write_compute_include "$jobs" "${target_entry%%|*}"
    fi
    target_entry=""
  fi

  if [[ -n "$requested_job" ]]; then
    target_entry="$(find_job_entry "$jobs" "$requested_job")" || die "Active fasrc job $requested_job was not found."
    target_alias="$(job_alias "$requested_job")"
    if ! probe_compute_alias "$target_alias"; then
      reset_login_connection
      probe_compute_alias "$target_alias" || die "Active fasrc job $requested_job exists, but SSH to $target_alias is not responding."
    fi
  elif ((force_new)) || [[ -z "$jobs" ]]; then
    ((time_set)) || alloc_args+=(--time 08:00:00)
    ((cpus_set)) || alloc_args+=(--cpus-per-task 4)
    ((mem_set)) || alloc_args+=(--mem 16G)
    target_entry="$(allocate_new_job "${alloc_args[@]}")"
    jobs="$(append_job_entry "$jobs" "$target_entry")"
    allocated_new=1
  else
    target_entry="$(choose_default_entry "$jobs")" || die "No active fasrc job was found."
    target_job="${target_entry%%|*}"
    target_alias="$(job_alias "$target_job")"
    if ! probe_compute_alias "$target_alias"; then
      reset_login_connection
      probe_compute_alias "$target_alias" || die "Default fasrc job $target_job exists, but SSH to $target_alias is not responding. Use 'fasrc new ...' for a new job or 'fasrc --job JOB_ID' for a specific other job."
    fi
  fi

  refresh_local_config "$jobs" "$target_entry"

  target_job="${target_entry%%|*}"
  target_alias="$(job_alias "$target_job")"

  if ((allocated_new)); then
    printf 'Allocated new job %s via alias %s.\n' "$target_job" "$target_alias" >&2
    wait_for_compute_alias "$target_alias" || die "Allocated job $target_job, but SSH to $target_alias did not become ready within ${SSH_READY_TIMEOUT}s."
  else
    printf 'Reusing job %s via alias %s.\n' "$target_job" "$target_alias" >&2
  fi

  home_path="$(remote_home)"
  install_root="$(vscode_server_install_root "$home_path")"
  ensure_vscode_remote_settings "$target_alias" "$install_root"

  if ((no_open)); then
    return
  fi

  uri="$(build_remote_uri "$target_alias" "$home_path" "$open_path")"
  prepare_code_cli_limits
  if [[ "${FASRC_REUSE_WINDOW:-0}" == "1" ]]; then
    code --folder-uri "$uri"
  else
    code --new-window --folder-uri "$uri"
  fi
}

bootstrap_cmd() {
  ensure_login_connection
  bootstrap_remote_keys
  printf 'FASRC authorized_keys bootstrap complete.\n'
}

status_cmd() {
  local jobs target_entry current_job current_alias job_id node alias marker

  ensure_login_connection
  jobs="$(list_remote_jobs)"

  if [[ -z "$jobs" ]]; then
    clear_current_job
    write_placeholder_include
    printf 'No active %s jobs.\n' "$JOB_NAME"
    return
  fi

  target_entry="$(choose_default_entry "$jobs")"
  current_job="${target_entry%%|*}"
  current_alias="$(job_alias "$current_job")"
  write_compute_include "$jobs" "$current_job"

  printf 'Generic alias %s resolves dynamically at connection time.\n' "$REMOTE_ALIAS"
  printf 'Current preferred job: %s\n' "$current_alias"
  while IFS='|' read -r job_id node; do
    [[ -n "$job_id" ]] || continue
    alias="$(job_alias "$job_id")"
    marker=" "
    if [[ "$job_id" == "$current_job" ]]; then
      marker="*"
    fi
    printf '%s job %s on %s (%s)\n' "$marker" "$job_id" "$node" "$alias"
  done <<<"$jobs"
}

stop_cmd() {
  local stop_all=0
  local requested_job=""
  local jobs target_entry current_job remaining_jobs
  local job_id node cancel_ids=""

  while (($#)); do
    case "$1" in
      --all)
        stop_all=1
        shift
        ;;
      --job)
        [[ $# -ge 2 ]] || die "Missing value for --job"
        requested_job="$2"
        shift 2
        ;;
      *)
        die "Unknown option for stop: $1"
        ;;
    esac
  done

  [[ "$stop_all" -eq 0 || -z "$requested_job" ]] || die "Use either --all or --job, not both."

  ensure_login_connection
  jobs="$(list_remote_jobs)"

  if [[ -z "$jobs" ]]; then
    clear_current_job
    write_placeholder_include
    printf 'No active %s jobs.\n' "$JOB_NAME"
    return
  fi

  if ((stop_all)); then
    while IFS='|' read -r job_id node; do
      [[ -n "$job_id" ]] || continue
      cancel_ids+=" $job_id"
    done <<<"$jobs"
  else
    if [[ -n "$requested_job" ]]; then
      target_entry="$(find_job_entry "$jobs" "$requested_job")" || die "Active fasrc job $requested_job was not found."
    else
      target_entry="$(choose_default_entry "$jobs")"
    fi
    current_job="${target_entry%%|*}"
    cancel_ids=" $current_job"
  fi

  ssh "$LOGIN_HOST" "scancel${cancel_ids}"

  remaining_jobs="$(list_remote_jobs)"
  if [[ -z "$remaining_jobs" ]]; then
    clear_current_job
    write_placeholder_include
    printf 'Cancelled requested job(s); no active %s jobs remain.\n' "$JOB_NAME"
    return
  fi

  target_entry="$(choose_default_entry "$remaining_jobs")"
  refresh_local_config "$remaining_jobs" "$target_entry"
  printf 'Cancelled requested job(s); refreshed %s aliases.\n' "$REMOTE_ALIAS"
}

[[ -f "$SSH_INCLUDE" ]] || write_placeholder_include

subcommand="${1:-launch}"
case "$subcommand" in
  launch)
    shift || true
    launch_cmd "$@"
    ;;
  resume)
    shift || true
    launch_cmd "$@"
    ;;
  new)
    shift || true
    launch_cmd --new "$@"
    ;;
  update|setup)
    shift || true
    setup_vscode_cmd "$@"
    ;;
  extensions|extension|ext)
    shift || true
    extensions_cmd "$@"
    ;;
  bootstrap)
    shift || true
    bootstrap_cmd "$@"
    ;;
  status)
    shift || true
    status_cmd "$@"
    ;;
  stop)
    shift || true
    stop_cmd "$@"
    ;;
  -h|--help|help)
    shift || true
    help_cmd "$@"
    ;;
  *)
    launch_cmd "$@"
    ;;
esac
